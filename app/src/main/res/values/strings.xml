    <!-- terms -->
    <string name="terms_section1_title">1. Aceitação dos termos</string>
    <string name="terms_section1_paragraph">Ao utilizar o aplicativo Aether, você concorda com os termos e condições descritos neste documento. Caso não concorde, recomendamos que encerre o uso do aplicativo.</string>
    <string name="terms_section2_title">2. Sobre o Aether</string>
    <string name="terms_section2_paragraph">O Aether é uma plataforma de gestão de emissões de gases de efeito estufa voltada para empresas do setor corporativo. Oferece ferramentas de análise, calculadora de CO₂ e orientações sobre gases verdes para substituição.</string>
    <string name="terms_section3_title">3. Uso da plataforma</string>
    <string name="terms_section3_bullet1">O usuário é responsável pela veracidade dos dados inseridos nos relatórios</string>
    <string name="terms_section3_bullet2">É proibido inserir dados falsos ou manipulados</string>
    <string name="terms_section3_bullet3">O acesso é pessoal e intransferível</string>
    <string name="terms_section3_bullet4">O compartilhamento de login é proibido</string>
    <string name="terms_section4_title">4. Responsabilidades do Aether</string>
    <string name="terms_section4_bullet1">Os resultados da calculadora são estimativas baseadas em dados científicos, não substituem laudos técnicos</string>
    <string name="terms_section4_bullet2">O Aether não se responsabiliza por decisões tomadas exclusivamente com base nas análises geradas pelo app</string>
    <string name="terms_section4_bullet3">A plataforma pode ficar indisponível para manutenção com aviso prévio</string>
    <string name="terms_section5_title">5. Alterações nos termos</string>
    <string name="terms_section5_bullet1">O Aether pode atualizar estes termos com aviso prévio de 15 dias</string>
    <string name="terms_section5_bullet2">O uso continuado após a atualização indica aceitação</string>
    <string name="terms_section6_title">6. Contato</string>
    <string name="terms_title">Termos de uso</string>

    <!-- privacy -->
    <string name="privacy_section1_title">1. Introdução</string>
    <string name="privacy_section1_paragraph">O Aether respeita sua privacidade e está comprometido com a proteção dos seus dados pessoais, em conformidade com a Lei Geral de Proteção de Dados (LGPD — Lei 13.709/2018).</string>
    <string name="privacy_section2_title">2. Quais dados coletamos</string>
    <string name="privacy_section2_bullet1">Dados de cadastro: nome, e-mail, cargo, empresa</string>
    <string name="privacy_section2_bullet2">Dados de uso: relatórios enviados, simulações realizadas, histórico de acesso</string>
    <string name="privacy_section2_bullet3">Dados técnicos: tipo de dispositivo, versão do app, logs de erro</string>
    <string name="privacy_section3_title">3. Como usamos seus dados</string>
    <string name="privacy_section3_bullet1">Personalizar a experiência do usuário no app</string>
