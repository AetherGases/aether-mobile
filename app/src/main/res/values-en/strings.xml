    <!-- terms -->
    <string name="terms_section1_title">1. Acceptance of the terms</string>
    <string name="terms_section1_paragraph">By using the Aether app, you agree to the terms and conditions described in this document. If you do not agree, we recommend that you stop using the app.</string>
    <string name="terms_section2_title">2. About Aether</string>
    <string name="terms_section2_paragraph">Aether is a greenhouse gas emissions management platform for corporate companies. It offers analysis tools, a CO₂ calculator and guidance on green gases for replacement.</string>
    <string name="terms_section3_title">3. Use of the platform</string>
    <string name="terms_section3_bullet1">The user is responsible for the accuracy of the data entered in the reports</string>
    <string name="terms_section3_bullet2">Entering false or manipulated data is prohibited</string>
    <string name="terms_section3_bullet3">Access is personal and non-transferable</string>
    <string name="terms_section3_bullet4">Sharing logins is prohibited</string>
    <string name="terms_section4_title">4. Aether\'s responsibilities</string>
    <string name="terms_section4_bullet1">The calculator results are estimates based on scientific data and do not replace technical reports</string>
    <string name="terms_section4_bullet2">Aether is not responsible for decisions made solely based on the analyses generated by the app</string>
    <string name="terms_section4_bullet3">The platform may be unavailable for maintenance with prior notice</string>
    <string name="terms_section5_title">5. Changes to the terms</string>
    <string name="terms_section5_bullet1">Aether may update these terms with 15 days\' prior notice</string>
    <string name="terms_section5_bullet2">Continued use after the update indicates acceptance</string>
    <string name="terms_section6_title">6. Contact</string>
    <string name="terms_title">Terms of use</string>

    <!-- privacy -->
    <string name="privacy_section1_title">1. Introduction</string>
    <string name="privacy_section1_paragraph">Aether respects your privacy and is committed to protecting your personal data, in compliance with the Brazilian General Data Protection Law (LGPD — Law 13.709/2018).</string>
    <string name="privacy_section2_title">2. What data we collect</string>
    <string name="privacy_section2_bullet1">Registration data: name, email, job title, company</string>
    <string name="privacy_section2_bullet2">Usage data: submitted reports, simulations performed, access history</string>
    <string name="privacy_section2_bullet3">Technical data: device type, app version, error logs</string>
    <string name="privacy_section3_title">3. How we use your data</string>
    <string name="privacy_section3_bullet1">Personalize the user experience in the app</string>
    <string name="privacy_section3_bullet2">Generate analyses and green gas recommendations</string>
    <string name="privacy_section3_bullet3">Send notifications about reports and updates</string>
    <string name="privacy_section3_bullet4">Comply with legal and regulatory obligations</string>
    <string name="privacy_section4_title">4. Data sharing</string>
    <string name="privacy_section4_bullet1">Data is not sold to third parties</string>
    <string name="privacy_section4_bullet2">It may be shared with authorized managers, analysts and administrators of the registered company</string>
    <string name="privacy_section4_bullet3">It may be shared with regulatory authorities when required by law</string>
    <string name="privacy_section5_title">5. Your rights (LGPD)</string>
    <string name="privacy_section5_bullet1">Access your personal data</string>
    <string name="privacy_section5_bullet2">Correct incorrect data</string>
    <string name="privacy_section5_bullet3">Request deletion of your data</string>
    <string name="privacy_section5_bullet4">Revoke consent at any time</string>
    <string name="privacy_section5_bullet5">Request data portability</string>
    <string name="privacy_section6_title">6. Cookies and tracking</string>
    <string name="privacy_section6_bullet1">The app does not use third-party cookies</string>
    <string name="privacy_section6_bullet2">Usage data is collected only to improve the platform</string>
    <string name="privacy_section7_title">7. Contact</string>
    <string name="privacy_title">Privacy Policy</string>

